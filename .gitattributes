# O motor é binário: git não deve tentar diff nem normalizar quebra de linha.
*.wasm binary
*.png  binary

# Contam como "gerados/vendor" nas estatísticas de linguagem do GitHub,
# para o repositório não aparecer como 95% JavaScript minificado.
index.html                        linguist-generated=true
src/vendor/*                      linguist-vendored=true
engine/stockfish-lite-single.js   linguist-vendored=true
engine/stockfish-lite.js          linguist-vendored=true

# Scripts do Windows precisam de CRLF para o duplo clique funcionar sempre.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Scripts de macOS/Linux precisam de LF, mesmo se o clone for feito no Windows:
# com CRLF o shebang quebra ("bad interpreter").
*.sh      text eol=lf
*.command text eol=lf
*.py      text eol=lf

# O CSP libera os <script> inline do index.html por hash SHA-256, calculado
# sobre os bytes do arquivo. Se um clone no Windows (core.autocrlf=true)
# trocasse LF por CRLF, todo bloco de script mudaria de hash e o navegador
# bloquearia o app inteiro. Estes arquivos são LF em qualquer sistema.
*.html    text eol=lf
_headers  text eol=lf
